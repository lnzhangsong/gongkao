# 复制为 .env.local（本地开发）/ 配到 Vercel 项目环境变量，按需填写

# —— Supabase（认证 + 数据库，全托管）——
# 前端用（暴露到浏览器的是 anon key，配合 RLS 行级权限，可公开）
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# —— PostHog（产品埋点，云 · 美区）——
# Project API Key（phc_…），可公开。留空则埋点整体静默禁用，功能不受影响。
# 本地开发不必留空：localhost / 127.0.0.0/8 / ::1 / *.local 上即便配了 key 也不会初始化 SDK、
# 不上报任何事件（见 src/lib/analytics.ts 的本地来源守卫）。
VITE_POSTHOG_KEY=
# 采集端点。默认 `/ingest`：生产由 vercel.json rewrite、本地由 vite proxy 转发到
# https://us.i.posthog.com，走自身域名以规避广告拦截与跨境直连延迟。
# 仅当想绕过反代直连时才需要填完整 URL（如 https://us.i.posthog.com）
VITE_POSTHOG_HOST=
# 置 1 才会在本地来源上报。默认关闭——只在调试埋点本身（看事件是否正确发出）时临时打开
VITE_POSTHOG_ALLOW_LOCAL=

# —— 本地写接口令牌（可选，仅 scripts/api-server.mjs 读取）——
# 设置后本地 API 的写接口（规范词/试卷增删改）要求请求带匹配的 x-write-token 头；
# 浏览器侧在 devtools 里执行 localStorage.setItem('readbook:write-token', '<同值>')，
# 写入口的能力探测会自动带上它（见 docs/规范词与试卷写路径决策.md）。不设 = 本地写不设防。
WRITE_TOKEN=
