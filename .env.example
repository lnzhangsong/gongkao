# 复制为 .env.local（本地开发）/ 配到 Vercel 项目环境变量，按需填写

# —— Supabase（认证 + 数据库，全托管）——
# 前端用（暴露到浏览器的是 anon key，配合 RLS 行级权限，可公开）
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# —— PostHog（产品埋点，云 · 美区）——
# Project API Key（phc_…），可公开。留空则埋点整体静默禁用，功能不受影响
VITE_POSTHOG_KEY=
# 采集端点。默认 `/ingest`：生产由 vercel.json rewrite、本地由 vite proxy 转发到
# https://us.i.posthog.com，走自身域名以规避广告拦截与跨境直连延迟。
# 仅当想绕过反代直连时才需要填完整 URL（如 https://us.i.posthog.com）
VITE_POSTHOG_HOST=
