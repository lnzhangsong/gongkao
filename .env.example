# 复制为 .env.local（前端）/ .env（Vercel 项目环境变量），按需填写

# —— Supabase Auth（账号体系）——
# 前端认证 SDK 用（暴露到浏览器的是 anon key，可公开）
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# 服务端校验 token 用（api/me.ts 优先读这两个，缺省回落到 VITE_ 前缀变量）
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# —— Vercel Postgres（profiles 等用户数据；线上由 Vercel 自动注入）——
# 本地联调 profile 持久化时填写；不填则 /api/me 降级为仅返回身份信息
DATABASE_URL=postgres://...
