{
  "name": "readbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "读本 READBOOK — 每日人民日报精读与申论素材阅读应用",
  "scripts": {
    "dev": "vp dev",
    "dev:api": "node scripts/api-server.mjs",
    "dev:all": "node scripts/kill-port.mjs 8787 5173 && concurrently -n api,web -c blue,green --kill-others \"node scripts/api-server.mjs\" \"vp dev\"",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "vp fmt --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "prepare": "vp config"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
