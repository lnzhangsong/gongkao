{
  "name": "readbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "读本 READBOOK — 每日人民日报精读与申论素材阅读应用",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vp dev",
    "dev:api": "node scripts/api-server.mjs",
    "dev:all": "node scripts/kill-port.mjs 8787 5173 && concurrently -n api,web -c blue,green --kill-others \"node scripts/api-server.mjs\" \"vp dev\"",
    "build": "node scripts/ensure-db.mjs && tsc --noEmit && vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "node scripts/e2e.mjs",
    "db:rebuild": "node scripts/rebuild-db.mjs",
    "gate": "vp check && vp test run && vp run build",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "vp fmt --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "prepare": "vp config"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.43.0",
    "posthog-js": "^1.429.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.14.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
