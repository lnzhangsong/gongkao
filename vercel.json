{
  "functions": {
    "api/articles.ts": {
      "includeFiles": "data/articles.db"
    },
    "api/diag.ts": {
      "includeFiles": "data/articles.db"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
