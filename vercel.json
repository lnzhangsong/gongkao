{
  "functions": {
    "api/articles.ts": {
      "includeFiles": "data/articles.db"
    },
    "api/exams.ts": {
      "includeFiles": "data/articles.db"
    },
    "api/xingce.ts": {
      "includeFiles": "data/articles.db"
    },
    "api/terms.ts": {
      "includeFiles": "data/articles.db"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/ingest/static/(.*)",
      "destination": "https://us-assets.i.posthog.com/static/$1"
    },
    {
      "source": "/ingest/(.*)",
      "destination": "https://us.i.posthog.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
